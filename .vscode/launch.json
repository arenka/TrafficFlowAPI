{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TrafficFlow.API (:5100)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-solution",
            "program": "${workspaceFolder}/Backend/TrafficFlow.API/bin/Debug/net9.0/TrafficFlow.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Backend/TrafficFlow.API",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5100"
            }
        },
        {
            "name": "TrafficFlow.Web MVC (:5200)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-solution",
            "program": "${workspaceFolder}/Backend/TrafficFlow.Web/bin/Debug/net9.0/TrafficFlow.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Backend/TrafficFlow.Web",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5200"
            }
        }
    ],
    "compounds": [
        {
            "name": "Backend + MVC Dashboard (.NET)",
            "configurations": [
                "TrafficFlow.API (:5100)",
                "TrafficFlow.Web MVC (:5200)"
            ]
        }
    ]
}
