{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-solution",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Backend/TrafficFlow.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "1 - AI Microservice (FastAPI :8000)",
            "type": "process",
            "command": "${workspaceFolder}/AI_Models/venv/Scripts/uvicorn.exe",
            "args": [
                "inference_api:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}/AI_Models/src"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "2 - ASP.NET Core Web API (:5100)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--launch-profile",
                "http"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Backend/TrafficFlow.API"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "3 - ASP.NET Core MVC Dashboard (:5200)",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--launch-profile",
                "http"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Backend/TrafficFlow.Web"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Tum Sistemi Baslat (AI + API + MVC)",
            "dependsOrder": "parallel",
            "dependsOn": [
                "1 - AI Microservice (FastAPI :8000)",
                "2 - ASP.NET Core Web API (:5100)",
                "3 - ASP.NET Core MVC Dashboard (:5200)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
